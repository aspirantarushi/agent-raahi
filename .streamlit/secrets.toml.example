# Copy this file to .streamlit/secrets.toml and fill in your own values (kept out of git).
# Online: paste the same lines into the app's Secrets box (see docs/GO_ONLINE.md).
SUPERVISOR_PASSWORD = "choose-a-password"
CLINIC_PASSCODE = "..."
CLINIC_NAME = "..."
SUPABASE_URL = "..."
SUPABASE_SECRET_KEY = "..."
GEMINI_API_KEY = "..."
APP_URL = "..."
GROQ_API_KEY = "..."      # optional backup for reading stories
TAVILY_API_KEY = "..."    # optional backup search for research
SARVAM_API_KEY = "..."    # speech to text (Gemini is the backup)
