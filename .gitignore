# Secrets: never commit these
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Mac and tool files
.DS_Store
.understand-anything/

# Drafts waiting for the supervisor, or sent back
pending/

# Audit records and the problems log (stay on this computer / server)
audit/
problems/

# Next-step timelines of approved cases (live case progress)
timelines/

# New case files stay off GitHub (a deleted case must not survive in git history).
# The practice files already tracked are kept.
drafts/U-*
cases/U-*

# Shared case tracker records (facts known, visit log, slip codes)
tracker/

# Evaluation sessions (practice) and the impact log (real use, with permission)
evaluation/sessions/
impact/

# AI research briefs and approved research saved as knowledge (live data; export to knowledge/ by hand)
research/
knowledge_added/
