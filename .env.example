# Copy this file to a new file named .env (in the same folder) and paste your key after the = sign.
# .env is kept out of git, so your key is never uploaded.
GEMINI_API_KEY=
# Optional: a different Gemini model
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Groq, the free third backup for reading stories (after both Gemini models)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: Tavily, the research backup when Gemini's Google Search fails (official sites only)
TAVILY_API_KEY=

# Optional: Bhashini (MeitY) for languages other than English and Hindi
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Sarvam AI: speech to text for "Speak the story" (Gemini is the backup)
SARVAM_API_KEY=
